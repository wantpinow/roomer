# Dependencies
node_modules
.pnp
.pnp.js
.pnpm-store/

# Local env files. Secrets (AI_GATEWAY_API_KEY) live in the repo-root
# .env.local; Convex's CLI writes packages/backend/.env.local. `.env.example`
# files and apps/web/.env (only the non-secret local Convex URL) are
# deliberately committed.
.env
.env*.local
.env.e2e
!.env.example
!apps/web/.env

# Build output
.next/
# Regenerated by every `next dev` / `next build`, and its content depends on
# which ran last (.next/dev, .next, .next-e2e) — tracking it is pure churn.
# `tsc` passes without it.
next-env.d.ts
# apps/web builds here under `dev:e2e` (see next.config.ts)
.next-e2e/
out/
build
dist
*.tsbuildinfo

# Turbo
.turbo

# Testing
coverage
playwright-report/
test-results/

# Local Convex databases (e2e backend data dir)
.convex-e2e/
.convex/

# Agent tooling output (`pnpm mcp` writes images here)
.roomer-out/
.cache/

# Debug
npm-debug.log*

# Misc
.DS_Store
*.pem
