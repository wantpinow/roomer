{
  "name": "@roomer/core",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*/index.ts"
  },
  "scripts": {
    "lint": "eslint --max-warnings 0 .",
    "format": "prettier --write --ignore-path ../../.prettierignore \"**/*.ts\"",
    "format:check": "prettier --check --ignore-path ../../.prettierignore \"**/*.ts\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts/tsconfig.json",
    "test": "vitest run",
    "plan:preview": "tsx scripts/plan-preview.ts"
  },
  "dependencies": {
    "polygon-clipping": "^0.15.7",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@roomer/eslint-config": "workspace:*",
    "@roomer/typescript-config": "workspace:*",
    "@types/node": "^22.20.5",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
