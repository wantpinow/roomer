{
  "name": "@roomer/ui",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "eslint --max-warnings 0 .",
    "format": "prettier --write --ignore-path ../../.prettierignore \"**/*.{ts,tsx}\"",
    "format:check": "prettier --check --ignore-path ../../.prettierignore \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "radix-ui": "^1.4.3",
    "shadcn": "^4.1.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@roomer/eslint-config": "workspace:*",
    "@roomer/typescript-config": "workspace:*",
    "@tailwindcss/postcss": "4.1.18",
    "@types/node": "^22.20.5",
    "@types/react": "~19.2.18",
    "@types/react-dom": "~19.2.7",
    "eslint": "9.39.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "4.1.18",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "exports": {
    "./globals.css": "./src/styles/globals.css",
    "./postcss.config": "./postcss.config.mjs",
    "./lib/*": "./src/lib/*.ts",
    "./components/*": "./src/components/*.tsx",
    "./hooks/*": "./src/hooks/*.ts"
  }
}
