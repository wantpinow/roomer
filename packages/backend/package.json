{
  "name": "@roomer/backend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "CONVEX_AGENT_MODE=anonymous convex dev --local-cloud-port 3210 --local-site-port 3211",
    "lint": "eslint --max-warnings 0 convex/ tests/ scripts/",
    "format": "prettier --write --ignore-path ../../.prettierignore \"**/*.{ts,tsx}\"",
    "format:check": "prettier --check --ignore-path ../../.prettierignore \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit -p convex/tsconfig.json",
    "test": "vitest run",
    "seed": "tsx scripts/seed.ts",
    "seed:export": "tsx scripts/seed-export.ts",
    "e2e:backend": "tsx scripts/e2e-backend.ts",
    "e2e:setup": "tsx scripts/e2e-setup.ts"
  },
  "dependencies": {
    "@roomer/core": "workspace:*",
    "convex": "1.46.0",
    "convex-helpers": "0.1.128",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@edge-runtime/vm": "3.2.0",
    "@roomer/eslint-config": "workspace:*",
    "@roomer/typescript-config": "workspace:*",
    "@types/node": "^22.20.5",
    "convex-test": "0.0.61",
    "eslint": "9.39.5",
    "globals": "^17.13.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
