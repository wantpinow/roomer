    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.1",
    "@react-three/postprocessing": "3.2.0",
    "@resvg/resvg-js": "2.6.2",
    "@roomer/backend": "workspace:*",
    "@roomer/core": "workspace:*",
    "@roomer/ui": "workspace:*",
    "@t3-oss/env-nextjs": "^0.13.11",
    "ai": "7.0.137",
    "convex": "1.46.0",
    "convex-helpers": "0.1.128",
    "lucide-react": "^0.577.0",
    "mcp-handler": "2.3.0",
    "next": "16.3.8",
    "playwright": "1.63.0",
    "pngjs": "7.0.0",
    "postprocessing": "6.39.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.186.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@roomer/eslint-config": "workspace:*",
    "@roomer/typescript-config": "workspace:*",
    "@tailwindcss/postcss": "4.1.18",
    "@types/node": "^22.20.5",
    "@types/pngjs": "^6.0.5",
    "@types/react": "~19.2.18",
    "@types/react-dom": "~19.2.7",
    "@types/three": "0.186.0",
    "eslint": "9.39.5",
    "tailwindcss": "4.1.18",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
