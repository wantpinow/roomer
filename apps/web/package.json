{
  "name": "web",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000",
    "dev:e2e": "E2E_TESTING=true PHOTOREAL_STUB=1 NEXT_PUBLIC_CONVEX_URL=http://127.0.0.1:3220 CONVEX_URL=http://127.0.0.1:3220 RENDER_BASE_URL=http://localhost:3100 next dev --port 3100",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings 0 .",
    "format": "prettier --write --ignore-path ../../.prettierignore \"**/*.{ts,tsx}\"",
    "format:check": "prettier --check --ignore-path ../../.prettierignore \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "mcp": "tsx scripts/mcp-call.ts",
    "render:fixture": "tsx scripts/render-fixture.ts",
    "photoreal:spike": "tsx scripts/photoreal-spike.ts"
  },
  "dependencies": {
    "@ai-sdk/gateway": "4.0.110",
    "@modelcontextprotocol/client": "2.3.1",
