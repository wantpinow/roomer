{
  "name": "web",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000",
    "dev:e2e": "E2E_TESTING=true PHOTOREAL_STUB=1 NEXT_PUBLIC_CONVEX_URL=http://127.0.0.1:3220 next dev --port 3100",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings 0 .",
    "format": "prettier --write --ignore-path ../../.prettierignore \"**/*.{ts,tsx}\"",
    "format:check": "prettier --check --ignore-path ../../.prettierignore \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "mcp": "tsx scripts/mcp-call.ts"
  },
  "dependencies": {
    "@next/env": "16.3.8",
    "@roomer/backend": "workspace:*",
    "@roomer/core": "workspace:*",
    "@roomer/ui": "workspace:*",
    "@t3-oss/env-nextjs": "^0.13.11",
    "convex": "1.46.0",
    "convex-helpers": "0.1.128",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@roomer/eslint-config": "workspace:*",
    "@roomer/typescript-config": "workspace:*",
    "@tailwindcss/postcss": "4.1.18",
    "@types/node": "^22.20.5",
    "@types/react": "~19.2.18",
    "@types/react-dom": "~19.2.7",
    "eslint": "9.39.5",
    "tailwindcss": "4.1.18",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
