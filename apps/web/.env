# Committed on purpose: the only value here is the non-secret URL of the local
# Convex deployment that `pnpm dev` starts (packages/backend, pinned to port
# 3210). Next loads this file in every mode at the lowest priority, so
# `dev:e2e`'s inline NEXT_PUBLIC_CONVEX_URL (port 3220) wins over it.
#
# Secrets do NOT go here: AI_GATEWAY_API_KEY lives in the repo-root .env.local
# (gitignored), which next.config.ts loads via @next/env.
NEXT_PUBLIC_CONVEX_URL=http://127.0.0.1:3210
